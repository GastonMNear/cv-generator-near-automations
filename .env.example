# Smartlead API Configuration
SMARTLEAD_API_KEY=
SMARTLEAD_WEBHOOK_SECRET=

# Clay API Configuration
CLAY_API_KEY=
CLAY_TABLE_ID=

# Campaign to Clay Workflow Mapping (JSON format)
